{
  "name": "gigacouch-site",
  "private": true,
  "description": "Giga Couch v1: upload, browse, and play web games in Chrome. Local development uses SQLite and files on disk.",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next dev --port 3000",
    "build": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next build",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next start --port 3000",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node scripts/smoke.mjs --seed"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
