{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Giga Couch web-1 package",
  "description": "Minimal local package for the web-1 browser. This schema does not describe hashes, signatures, or a certified sandbox.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "game_id",
    "title",
    "version",
    "runtime",
    "entrypoint",
    "gigacouch_api",
    "players"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "game_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "runtime": {
      "const": "web-1"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^web/[A-Za-z0-9_./-]+\\.html$"
    },
    "gigacouch_api": {
      "const": "1"
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Optional. The most players this game allows. Players past it wait on their phones or pads until there is room."
        }
      },
      "description": "How many people can play. Without max, everyone who joins gets to play; phones make dozens possible."
    },
    "phone": {
      "type": "object",
      "additionalProperties": false,
      "description": "Phone controllers while this game is open: the layout, and the game's own sounds. Without it, phones show stick-2 and only the stock sounds play.",
      "properties": {
        "layout": {
          "description": "A built-in layout (stick-2, dpad-2, stick-4, twin-stick, one-button, quiz-4, racing, paddle, touchpad, lanes-4, two-choice, draw) or one of this game's phone.layouts.",
          "type": "string"
        },
        "sounds": {
          "type": "object",
          "maxProperties": 32,
          "description": "The game's own phone sounds: a name to a file inside web/. MP3, M4A, or WAV; at most 256 KiB each and 2 MiB together. Names cannot reuse the stock sounds: click, tick, ding, success, fail, buzzer, coin, whoosh.",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "not": {
              "enum": [
                "click",
                "tick",
                "ding",
                "success",
                "fail",
                "buzzer",
                "coin",
                "whoosh"
              ]
            }
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/.\\\\][^\\\\]*\\.(mp3|m4a|wav|MP3|M4A|WAV)$"
          }
        },
        "images": {
          "type": "object",
          "maxProperties": 64,
          "description": "The game's own images for private phone screens: a name to a file inside web/. PNG, JPG, or WebP (no SVG); at most 512 KiB each and 4 MiB together.",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/.\\\\][^\\\\]*\\.(png|jpg|jpeg|webp|PNG|JPG|JPEG|WEBP)$"
          }
        },
        "layouts": {
          "type": "object",
          "maxProperties": 16,
          "description": "The game's own controller layouts, by name. Positions are fractions of the phone's control area. The host keeps only these fields; the pad draws from them.",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "landscape"
            ],
            "properties": {
              "landscape": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "stick",
                        "dpad",
                        "button",
                        "arrow",
                        "slider",
                        "touchpad",
                        "canvas",
                        "palette"
                      ]
                    },
                    "key": {
                      "enum": [
                        "south",
                        "east",
                        "west",
                        "north",
                        "start"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "hint": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "color": {
                      "enum": [
                        "mint",
                        "blue",
                        "amber",
                        "coral",
                        "panel"
                      ]
                    },
                    "axis": {
                      "enum": [
                        "move",
                        "look"
                      ]
                    },
                    "dir": {
                      "enum": [
                        -1,
                        1
                      ]
                    },
                    "small": {
                      "type": "boolean"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "size": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "rect": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  }
                }
              },
              "portrait": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "stick",
                        "dpad",
                        "button",
                        "arrow",
                        "slider",
                        "touchpad",
                        "canvas",
                        "palette"
                      ]
                    },
                    "key": {
                      "enum": [
                        "south",
                        "east",
                        "west",
                        "north",
                        "start"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "hint": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "color": {
                      "enum": [
                        "mint",
                        "blue",
                        "amber",
                        "coral",
                        "panel"
                      ]
                    },
                    "axis": {
                      "enum": [
                        "move",
                        "look"
                      ]
                    },
                    "dir": {
                      "enum": [
                        -1,
                        1
                      ]
                    },
                    "small": {
                      "type": "boolean"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "size": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "rect": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
