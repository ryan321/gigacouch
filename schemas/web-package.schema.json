{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Giga Couch web-1 package",
  "description": "Minimal local package for the web-1 browser. This schema does not describe hashes, signatures, or a certified sandbox.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "game_id",
    "title",
    "version",
    "runtime",
    "entrypoint",
    "gigacouch_api",
    "players"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "game_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "runtime": {
      "const": "web-1"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^web/[A-Za-z0-9_./-]+\\.html$"
    },
    "gigacouch_api": {
      "const": "1"
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Optional. The most players this game allows. Players past it wait on their phones or pads until there is room."
        }
      },
      "description": "How many people can play. Without max, everyone who joins gets to play; phones make dozens possible."
    },
    "actions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
        "not": {
          "enum": [
            "south",
            "east",
            "west",
            "north",
            "start",
            "move",
            "look",
            "jump",
            "leave",
            "primary_action",
            "secondary_action"
          ]
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "enum": [
              "button",
              "axis"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "button",
                  "axis"
                ]
              },
              "pad": {
                "enum": [
                  "south",
                  "east",
                  "west",
                  "north",
                  "start",
                  "move",
                  "look"
                ],
                "description": "What a pad or keyboard uses instead: a key for a button, a stick for an axis."
              }
            }
          }
        ]
      },
      "description": "The game's own inputs by name, such as boost or throttle. Phone layouts bind buttons and axes to them, and games read them with GigaCouch.input like the standard ones. pad names the standard key or stick that stands in for it on pads and keyboards."
    },
    "phone": {
      "type": "object",
      "additionalProperties": false,
      "description": "Phone controllers while this game is open: the layout, and the game's own sounds. Without it, phones show stick-2 and only the stock sounds play.",
      "properties": {
        "layout": {
          "description": "A built-in layout (stick-2, dpad-2, stick-4, twin-stick, one-button, quiz-4, racing, paddle, touchpad, lanes-4, two-choice, draw) or one of this game's phone.layouts.",
          "type": "string"
        },
        "sounds": {
          "type": "object",
          "maxProperties": 32,
          "description": "The game's own phone sounds: a name to a file inside web/. MP3, M4A, or WAV; at most 256 KiB each and 2 MiB together. Names cannot reuse the stock sounds: click, tick, ding, success, fail, buzzer, coin, whoosh.",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "not": {
              "enum": [
                "click",
                "tick",
                "ding",
                "success",
                "fail",
                "buzzer",
                "coin",
                "whoosh"
              ]
            }
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/.\\\\][^\\\\]*\\.(mp3|m4a|wav|MP3|M4A|WAV)$"
          }
        },
        "images": {
          "type": "object",
          "maxProperties": 64,
          "description": "The game's own images for private phone screens: a name to a file inside web/. PNG, JPG, or WebP (no SVG); at most 512 KiB each and 4 MiB together.",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/.\\\\][^\\\\]*\\.(png|jpg|jpeg|webp|PNG|JPG|JPEG|WEBP)$"
          }
        },
        "layouts": {
          "type": "object",
          "maxProperties": 16,
          "description": "The game's own controller layouts, by name. Positions are fractions of the phone's control area. The host keeps only these fields; the pad draws from them.",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "landscape"
            ],
            "properties": {
              "landscape": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "stick",
                        "dpad",
                        "button",
                        "arrow",
                        "slider",
                        "touchpad",
                        "canvas",
                        "palette"
                      ]
                    },
                    "key": {
                      "anyOf": [
                        {
                          "enum": [
                            "south",
                            "east",
                            "west",
                            "north",
                            "start"
                          ]
                        },
                        {
                          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                        }
                      ],
                      "description": "A standard key, or one of the game's button actions."
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "hint": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "color": {
                      "enum": [
                        "mint",
                        "blue",
                        "amber",
                        "coral",
                        "panel"
                      ]
                    },
                    "axis": {
                      "anyOf": [
                        {
                          "enum": [
                            "move",
                            "look"
                          ]
                        },
                        {
                          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                        }
                      ],
                      "description": "A standard stick, or one of the game's axis actions."
                    },
                    "dir": {
                      "enum": [
                        -1,
                        1
                      ]
                    },
                    "small": {
                      "type": "boolean"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "size": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "rect": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "feedback": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "sound": {
                          "type": "string",
                          "description": "A stock sound (click, tick, ding, success, fail, buzzer, coin, whoosh) or one of phone.sounds."
                        },
                        "rumble": {
                          "enum": [
                            "tap",
                            "bump",
                            "hit",
                            "long",
                            "double",
                            "heartbeat"
                          ]
                        },
                        "flash": {
                          "type": "boolean"
                        }
                      },
                      "description": "Played on the phone the moment the control is pressed, with no trip to the computer."
                    }
                  }
                }
              },
              "portrait": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "stick",
                        "dpad",
                        "button",
                        "arrow",
                        "slider",
                        "touchpad",
                        "canvas",
                        "palette"
                      ]
                    },
                    "key": {
                      "anyOf": [
                        {
                          "enum": [
                            "south",
                            "east",
                            "west",
                            "north",
                            "start"
                          ]
                        },
                        {
                          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                        }
                      ],
                      "description": "A standard key, or one of the game's button actions."
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "hint": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "color": {
                      "enum": [
                        "mint",
                        "blue",
                        "amber",
                        "coral",
                        "panel"
                      ]
                    },
                    "axis": {
                      "anyOf": [
                        {
                          "enum": [
                            "move",
                            "look"
                          ]
                        },
                        {
                          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                        }
                      ],
                      "description": "A standard stick, or one of the game's axis actions."
                    },
                    "dir": {
                      "enum": [
                        -1,
                        1
                      ]
                    },
                    "small": {
                      "type": "boolean"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "size": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "rect": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "feedback": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "sound": {
                          "type": "string",
                          "description": "A stock sound (click, tick, ding, success, fail, buzzer, coin, whoosh) or one of phone.sounds."
                        },
                        "rumble": {
                          "enum": [
                            "tap",
                            "bump",
                            "hit",
                            "long",
                            "double",
                            "heartbeat"
                          ]
                        },
                        "flash": {
                          "type": "boolean"
                        }
                      },
                      "description": "Played on the phone the moment the control is pressed, with no trip to the computer."
                    }
                  }
                }
              }
            }
          }
        },
        "views": {
          "type": "object",
          "description": "The game's own panel views, by name: lists of text, image, choices, and text-input items shown above the controller with GigaCouch.phone.show(player, name, data). Any value can be {\"bind\": \"path\"} into the data. Names cannot be screen or ask, the built-in views.",
          "propertyNames": {
            "pattern": "^[a-z0-9-]{1,32}$",
            "not": {
              "enum": [
                "screen",
                "ask"
              ]
            }
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "text",
                        "image",
                        "choices",
                        "text-input"
                      ]
                    },
                    "style": {
                      "enum": [
                        "title",
                        "body"
                      ]
                    },
                    "text": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 1000
                        },
                        {
                          "type": "object",
                          "required": [
                            "bind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "bind": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
                              "maxLength": 64
                            }
                          }
                        }
                      ]
                    },
                    "image": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "required": [
                            "bind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "bind": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
                              "maxLength": 64
                            }
                          }
                        }
                      ]
                    },
                    "choices": {
                      "oneOf": [
                        {
                          "type": "array",
                          "maxItems": 12
                        },
                        {
                          "type": "object",
                          "required": [
                            "bind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "bind": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
                              "maxLength": 64
                            }
                          }
                        }
                      ]
                    },
                    "id": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 32
                        },
                        {
                          "type": "object",
                          "required": [
                            "bind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "bind": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
                              "maxLength": 64
                            }
                          }
                        }
                      ]
                    },
                    "prompt": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 120
                        },
                        {
                          "type": "object",
                          "required": [
                            "bind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "bind": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
                              "maxLength": 64
                            }
                          }
                        }
                      ]
                    },
                    "placeholder": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 60
                        },
                        {
                          "type": "object",
                          "required": [
                            "bind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "bind": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
                              "maxLength": 64
                            }
                          }
                        }
                      ]
                    },
                    "max": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 500
                        },
                        {
                          "type": "object",
                          "required": [
                            "bind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "bind": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
                              "maxLength": 64
                            }
                          }
                        }
                      ]
                    },
                    "multiline": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "required": [
                            "bind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "bind": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
                              "maxLength": 64
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
